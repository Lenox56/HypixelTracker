# Kopieren nach .env und ausfuellen:  cp .env.example .env
# Die .env-Datei NIEMALS committen oder weitergeben!

# Key deiner Hypixel-Application (developer.hypixel.net)
HYPIXEL_API_KEY=

# Domain, unter der der Server erreichbar ist (A-Record auf die Server-IP)
DOMAIN=tracker.example.com

# Wie lange Profil-Antworten zwischengespeichert werden (Sekunden)
CACHE_TTL_SECONDS=300

# Max. Anfragen pro Minute und Client-IP
CLIENT_REQUESTS_PER_MINUTE=30
